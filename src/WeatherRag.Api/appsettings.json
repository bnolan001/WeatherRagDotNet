{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Rag": {
    "DocumentStorePath": "data/documents",
    "IndexStorePath": "data/index"
  },
  "Chunking": {
    "MaxTokens": 512,
    "OverlapTokens": 64
  },
  "Embedding": {
    "ModelPath": "models/embedding/model.onnx",
    "VocabPath": "models/embedding/vocab.txt",
    "Dimensions": 384,
    "MaxSequenceLength": 512,
    "ProviderPriority": [ "OpenVINO", "DirectML", "CPU" ],
    "OpenVinoDeviceType": "AUTO",
    "DirectMlDeviceId": 0,
    "EnableCpuFallback": true,
    "GraphOptimizationLevel": "ORT_ENABLE_ALL",
    "IntraOpThreads": 0,
    "InterOpThreads": 0,
    "EnableMemoryPattern": true,
    "EnableCpuMemArena": true,
    "EnableWarmup": true
  },
  "VectorStore": {
    "PersistencePath": "data/index/vectors.json",
    "TopK": 5,
    "MinScore": 0.3
  },
  "Inference": {
    "DefaultModelId": "default",
    "Models": {
      "default": {
        "DisplayName": "Default Model",
        "ModelPath": "models/llm/model.gguf",
        "ContextSize": 4096,
        "MaxTokens": 1024,
        "Temperature": 0.2,
        "GpuLayerCount": 32,
        "Threads": 8
      },
      "gemma4": {
        "DisplayName": "Gemma 4",
        "ModelPath": "models/llm/gemma-4-E4B-it-qat-UD-Q4_K_XL.gguf",
        "ContextSize": 8192,
        "MaxTokens": 1024,
        "Temperature": 1,
        "GpuLayerCount": 32,
        "Threads": 8
      },
      "gemma4_12b": {
        "DisplayName": "Gemma 4 12B",
        "ModelPath": "models/llm/gemma-4-12B-it-qat-UD-Q4_K_XL.gguf",
        "ContextSize": 8192,
        "MaxTokens": 1024,
        "Temperature": 1,
        "GpuLayerCount": 32,
        "Threads": 8
      }
    }
  }
}
